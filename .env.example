# Backend API kök adresi (/api/v1 eklenir). Build sırasında koda gömülür.
# Yerelde boş bırakın: istekler Vite proxy'si üzerinden VITE_API_PROXY_TARGET'a gider.
# Production'da da boş: backend ve frontend DigitalOcean'da aynı adreste (/api → backend).
# Ayrı bir API alan adı kullanılırsa tam adres yazılır (ör. https://api.rapidquiz.app).
VITE_API_BASE_URL=

# Yalnızca `npm run dev` için: /api isteklerinin aktarılacağı backend.
VITE_API_PROXY_TARGET=http://localhost:8000
